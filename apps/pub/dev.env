# `bun run setup` copies this to .env for local development (Void reads only .env). Production values are set with `void secret put`.
SERVE_TOKEN_SECRET=dev-serve-token-secret-change-me
DECK_ORIGIN=http://d-{id}.localhost:5173
APP_ORIGIN=http://localhost:5173
DEK_PUB_DEV_LOGIN=1
# Lets anyone sign up, here only, as DEK_PUB_DEV_LOGIN is 1 too; production never sets it, and its operators invite people from /settings.
DEK_PUB_OPEN_SIGN_UP=1
# Who runs dek.pub: addresses whose verified account may delete anyone's talk, for a takedown, may sign up uninvited, and invite others from /settings. Empty names no one.
DEK_PUB_OPERATORS=
# Placeholders: GitHub sign-in needs a real OAuth app; email sign-up stands in locally.
AUTH_GITHUB_CLIENT_ID=dev-github-client-id
AUTH_GITHUB_CLIENT_SECRET=dev-github-client-secret
# The talk the landing page shows, as @handle/slug, once it is public; `bun scripts/seed.ts` makes @demo/why-dek.
FEATURED_TALK=@demo/why-dek
