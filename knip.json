{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/runtime/browser.ts",
        "src/runtime/browser-live.ts",
        "src/runtime/annotate.ts",
        "src/core/*-worker.ts",
        "src/video/worker.ts",
        "src/plugins/*/main.ts",
        "src/plugins/*/page.ts",
        "src/pub/protocol.ts",
        "tests/helpers/fake-*.ts",
        "scripts/*.ts",
        "evals/agent/shim.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "evals/**/*.ts"
      ],
      "ignoreDependencies": [
        "publint"
      ]
    },
    "apps/pub": {
      "entry": [
        "void.config.ts",
        "pages/**/*.{ts,svelte}",
        "routes/**/*.ts",
        "middleware/**/*.ts",
        "db/schema.ts",
        "auth.ts",
        "env.ts",
        "scripts/*.ts",
        "tests/**/*.ts"
      ],
      "project": [
        "**/*.{ts,svelte}"
      ],
      "vite": false,
      "paths": {
        "@schema": [
          "db/schema.ts"
        ]
      }
    }
  }
}
