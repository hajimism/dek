            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ls": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "diagnostics": {
              "type": "array",
