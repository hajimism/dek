            },
            "videoSeconds": {
              "type": "number"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "beats": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "estimateSeconds": {
                    "type": "number"
                  },
                  "budgetSeconds": {
                    "type": "number"
                  },
                  "videoSeconds": {
                    "type": "number"
                  }
                },
                "required": [
                  "slug",
                  "title",
                  "beats",
                  "estimateSeconds"
