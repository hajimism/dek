{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hajimism.github.io/dek/cli.schema.json",
  "title": "dek --json",
  "description": "What each dek command prints with --json, one JSON object per line. $defs holds one schema per command, and `failure` for a command line that could not run. While dek is 0.x the shape may change between releases.",
  "$defs": {
    "init": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "root": {
              "type": "string"
            },
            "created": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "updated": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "dek's own files, already there, brought up to date."
            },
            "kept": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files already there that differ from what init would write."
            },
            "next": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The commands to run next."
            },
            "playwright": {
              "description": "How to install Playwright, when it is missing.",
              "type": "string"
            },
            "missingTokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ok": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "root",
            "created",
            "updated",
            "kept",
            "next",
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "$ref": "#/$defs/Error"
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "new": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "dir": {
              "type": "string"
            },
            "created": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "updated": {
              "type": "array",
              "items": {
                "type": "string"
              }
