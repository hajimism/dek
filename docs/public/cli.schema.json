                "additionalProperties": false
              }
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Diagnostic"
              }
            },
            "skipped": {
              "description": "Absent when every check ran.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/SkippedCheck"
              }
            },
            "ref": {
              "$ref": "#/$defs/RefInfo"
            },
            "ok": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "name",
            "title",
            "estimateSeconds",
            "sections",
            "diagnostics",
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
