{
  "name": "@hajimism/dek",
  "version": "0.2.2",
  "description": "A build system for talks.",
  "license": "MIT",
  "author": "Hajime Nakagawa (https://github.com/hajimism)",
  "type": "module",
  "bin": {
    "dekc": "src/cli.ts"
  },
  "files": [
    "src",
    "skills",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hajimism/dek.git"
  },
  "bugs": {
    "url": "https://github.com/hajimism/dek/issues"
  },
  "homepage": "https://hajimism.github.io/dek/",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "talk",
    "markdown",
    "build",
    "cli",
    "html",
    "bun",
    "ai-agents"
  ],
  "scripts": {
    "test": "bun test --parallel=4",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "schema": "bun scripts/cli-schema.ts",
    "llms": "bun scripts/llms.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "docs:dev": "vitepress dev docs",
    "docs:samples": "cd sample && bun ../src/cli.ts build --root-dist && mkdir -p ../docs/public/samples && cp dist/*.html dist/*.png ../docs/public/samples/",
    "docs:build": "bun run docs:samples && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "^1.4.2",
    "happy-dom": "20.14.5",
    "knip": "6.38.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
